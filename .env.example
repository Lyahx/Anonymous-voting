# Zorunlu: admin paneli parolası
ADMIN_PASSWORD=
# QR kodlarının göstereceği herkese açık adres (boşsa tarayıcının adresi kullanılır)
PUBLIC_URL=
# İsteğe bağlı: admin oturum imzası için sabit anahtar (boşsa her açılışta yenilenir)
SESSION_SECRET=
PORT=3001
# Railway vb. proxy arkasında 1 yap (hız sınırı gerçek IP ile çalışsın). Doğrudan internete açıkken boş bırak.
TRUST_PROXY=
# Veritabanı dosyası. Kalıcı disk (volume) kullanıyorsan yolu oraya ver, örn. /data/data.db
DB_FILE=
